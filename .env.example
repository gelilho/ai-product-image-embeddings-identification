# =============================================================================
# Product Image Identification – Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env – it is in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Image Fetcher
# ---------------------------------------------------------------------------
# Base URL for product images (Azure Blob)
PII_IMAGE_BASE_URL=https://onretailimages.blob.core.windows.net/prod-mediaserver/Products
# Image URL suffix appended after item code
PII_IMAGE_SUFFIX=_000_001.png
# Max concurrent image downloads
PII_FETCH_CONCURRENCY=3
# Requests per second rate limit
PII_FETCH_RATE_LIMIT=2.0
# Max image size in bytes (10 MB)
PII_FETCH_MAX_BYTES=10485760
# Request timeout in seconds
PII_FETCH_TIMEOUT=30

# ---------------------------------------------------------------------------
# Embedding Backend
# ---------------------------------------------------------------------------
# Which backend to use: marqo | siglip | dinov2 | qwen
PII_EMBEDDING_BACKEND=marqo
# Model name (backend-specific)
PII_EMBEDDING_MODEL=Marqo/marqo-ecommerce-embeddings-L
# Device: cpu | cuda | mps (auto-detected if empty)
PII_EMBEDDING_DEVICE=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Path to golden dataset (XLSX or CSV)
PII_GOLDEN_DATASET=data/golden/product_items_golden.xlsx
# Output directory for enriched CSV
PII_OUTPUT_DIR=data/output
# Embedding storage directory
PII_EMBEDDING_DIR=data/embeddings

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
PII_LOG_LEVEL=INFO
# Log format: text | json
PII_LOG_FORMAT=text
